<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relatório de Pontualidade - Marcos Contabilidade</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js for interactive charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        :root {
            --primary-color: #d94747; /* Red from the logo */
            --light-bg: #f4f4f5;
            --text-dark: #18181b;
            --success-color: #16a34a;
            --late-color: #dc2626;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--light-bg);
            color: var(--text-dark);
        }
        .card {
            background-color: white;
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
            border: 1px solid #e5e7eb;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .tab-button {
            padding: 0.75rem 1rem;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            font-weight: 600;
            color: #4b5563;
            transition: color 0.2s, border-color 0.2s;
            white-space: nowrap;
        }
        .tab-button.active {
            color: var(--primary-color);
            border-bottom-color: var(--primary-color);
        }
        .view-content { display: none; }
        .view-content.active { display: block; }
        .table-auto th {
            text-align: left;
            padding: 0.75rem 1rem;
            background-color: #f9fafb;
            font-size: 0.875rem;
            color: #374151;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .table-auto td { padding: 0.75rem 1rem; border-bottom: 1px solid #e5e7eb; }
        .badge { display: inline-block; padding: 0.25em 0.6em; font-size: 0.75rem; font-weight: 600; line-height: 1; text-align: center; white-space: nowrap; vertical-align: baseline; border-radius: 0.375rem; }
        .status-Atrasado { background-color: #fee2e2; color: #b91c1c; }
        .status-Adiantado { background-color: #dcfce7; color: #166534; }
        .status-No-Horário { background-color: #f3f4f6; color: #4b5563; }
        #validation-section .grid {
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        }
    </style>
</head>
<body class="p-4 sm:p-6 lg:p-8">
    <div class="max-w-7xl mx-auto">

        <header class="flex flex-col sm:flex-row items-center justify-between mb-8">
             <div class="flex items-center space-x-4">
                <img src="https://i.postimg.cc/QVzDwYPQ/2.png" alt="Marcos Contabilidade Logo" class="h-12" onerror="this.style.display='none'">
                <h1 class="text-2xl md:text-3xl font-bold text-slate-800">Relatório de Pontualidade</h1>
            </div>
            <div class="mt-4 sm:mt-0">
                <label for="month-selector" class="block text-sm font-medium text-gray-700 mb-2">Selecionar Mês:</label>
                <select id="month-selector" class="px-4 py-2 border border-gray-300 rounded-md bg-white text-gray-900 focus:ring-2 focus:ring-red-500 focus:border-red-500">
                    <option value="2025-05">Maio 2025</option>
                    <option value="2025-06">Junho 2025</option>
                </select>
            </div>
        </header>

        <!-- Tabs -->
        <div class="border-b border-gray-200 mb-6">
            <nav class="-mb-px flex space-x-2 sm:space-x-4 overflow-x-auto" aria-label="Tabs">
                <button class="tab-button active" data-tab="view-geral">Visão Geral</button>
                <button class="tab-button" data-tab="view-department">Por Departamento</button>
                <button class="tab-button" data-tab="view-ranking">Ranking de Atrasos</button>
                <button class="tab-button" data-tab="view-individual">Visão Individual</button>
                <button class="tab-button" data-tab="view-validation">Validação dos Dados</button>
            </nav>
        </div>

        <div id="view-geral" class="view-content active"></div>
        <div id="view-department" class="view-content"></div>
        <div id="view-ranking" class="view-content"></div>
        <div id="view-individual" class="view-content"></div>
        <div id="view-validation" class="view-content"></div>
    </div>

