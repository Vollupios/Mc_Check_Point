};

            // Month selection data
            const availableMonths = {
                '2025-05': {
                    name: 'Maio 2025',
                    data: allEmployeesData
                },
                '2025-06': {
                    name: 'Junho 2025',
                    data: allEmployeesData_2025_06
                }
            };

            let currentMonth = '2025-05';
            let currentEmployeesData = availableMonths[currentMonth].data;


            let activeCharts = {};

            function destroyChart(canvasId) {
                if (activeCharts[canvasId]) {
                    activeCharts[canvasId].destroy();
                    delete activeCharts[canvasId];
                }
            }
            
            function parseDate(dateString) {
                const parts = dateString.split('-');
                return new Date(Date.UTC(parts[0], parseInt(parts[1], 10) - 1, parts[2]));
            }

            function isValidTime(timeStr) {
                if (typeof timeStr !== 'string') return false;
                return /^\s*\d{1,2}:\d{2}/.test(timeStr.trim());
            }

            function parseTime(timeStr) {
                const cleanTime = timeStr.replace(/[^\d:]/g, '').trim();
                const [hours, minutes] = cleanTime.split(':').map(Number);
                return (hours * 60) + (minutes || 0);
            }
            
            function processData() {
                let processed = [];
                for (const employeeName in currentEmployeesData) {
                    const employeeData = currentEmployeesData[employeeName];
                    if (!employeeData.records || !employeeData.scheduledEntryTime || !employeeData.scheduledLeaveTime) continue;

                    const scheduledEntryMinutes = parseTime(employeeData.scheduledEntryTime);
                    const scheduledLeaveMinutes = parseTime(employeeData.scheduledLeaveTime);

                    employeeData.records.forEach(record => {
                        if (!isValidTime(record.ent1) || record.ent1.trim() === '0:00') return;
                        
                        const dateObj = parseDate(record.date);
                        const dayOfWeek = dateObj.getUTCDay();
                        if (dayOfWeek === 6 || dayOfWeek === 0) return; // Skip Saturday and Sunday

                        const actualEntryMinutes = parseTime(record.ent1);
                        const arrivalDifference = actualEntryMinutes - scheduledEntryMinutes;

                        let arrivalStatus;
                        if (arrivalDifference > 5) arrivalStatus = 'Atrasado';
                        else if (arrivalDifference < -5) arrivalStatus = 'Adiantado';
                        else arrivalStatus = 'No Horário';

                        let leaveDifference = 0;
                        if (isValidTime(record.sai2)) {
                            const actualLeaveMinutes = parseTime(record.sai2);
                            leaveDifference = actualLeaveMinutes - scheduledLeaveMinutes;
                        }
                        
                        processed.push({
                            employeeName,
                            department: employeeData.department,
                            dateObj,
                            formattedDate: dateObj.toLocaleDateString('pt-BR', {timeZone: 'UTC'}),
                            entryTime: record.ent1,
                            leaveTime: record.sai2,
                            arrivalDifference,
                            arrivalStatus,
                            leaveDifference
                        });
                    });
                }
                return processed;
            }
            


            function renderGeneralView() {
                const data = processData();
                const container = document.getElementById('view-geral');
                container.innerHTML = `
                    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
                        <div class="lg:col-span-2 card">
                            <h2 class="text-xl font-semibold text-slate-700 mb-4 text-center">Resumo Geral de Chegadas</h2>
                            <div class="h-64 sm:h-72"><canvas id="geral-pie-chart"></canvas></div>
                             <div id="geral-percentage-summary" class="text-center mt-4 space-y-1"></div>
                        </div>
                        <div class="lg:col-span-3 card">
                            <h2 class="text-xl font-semibold text-slate-700 mb-4 text-center">Média Diária de Chegada (Minutos)</h2>
                            <div class="h-64 sm:h-72"><canvas id="geral-bar-chart"></canvas></div>
                            <p class="text-xs text-center text-slate-500 mt-2">Média de minutos de todos os funcionários por dia.</p>
                        </div>
                    </div>
                    <div class="card">
                        <h2 class="text-xl font-semibold text-slate-700 mb-4">Todos os Registros de Entrada</h2>
                        <div class="overflow-x-auto">
                            <table class="w-full table-auto border-collapse">
                                <thead><tr><th>Data</th><th>Funcionário(a)</th><th>Horário Registrado</th><th>Status</th><th>Diferença (min)</th></tr></thead>
                                <tbody id="geral-table-body"></tbody>
                            </table>
                        </div>
                    </div>`;
                
                const arrivalStatusCounts = data.reduce((acc, rec) => {
                    acc[rec.arrivalStatus] = (acc[rec.arrivalStatus] || 0) + 1;
                    return acc;
                }, {});

                destroyChart('geral-pie-chart');
                
                // Map colors correctly to status
                const statusLabels = Object.keys(arrivalStatusCounts);
                const statusColors = statusLabels.map(status => {
                    if (status === 'Atrasado') return '#ef4444'; // Red
                    if (status === 'No Horário') return '#22c55e'; // Green
                    if (status === 'Adiantado') return '#eab308'; // Yellow
                    return '#6b7280'; // Gray fallback
                });
                
                activeCharts['geral-pie-chart'] = new Chart(document.getElementById('geral-pie-chart'), { type: 'doughnut', data: { labels: statusLabels, datasets: [{ data: Object.values(arrivalStatusCounts), backgroundColor: statusColors }] }, options: { responsive: true, maintainAspectRatio: false } });
                
                const totalRecords = data.length;
                const onTimeCount = (arrivalStatusCounts['Adiantado'] || 0) + (arrivalStatusCounts['No Horário'] || 0);
                const lateCount = arrivalStatusCounts['Atrasado'] || 0;
                const onTimePercentage = totalRecords > 0 ? ((onTimeCount / totalRecords) * 100).toFixed(1) : 0;
                const latePercentage = totalRecords > 0 ? ((lateCount / totalRecords) * 100).toFixed(1) : 0;
                
                document.getElementById('geral-percentage-summary').innerHTML = `
                    <p class="text-sm"><span class="font-bold text-green-600">${onTimePercentage}%</span> Em Conformidade (No Horário ou Adiantado)</p>
                    <p class="text-sm"><span class="font-bold text-red-600">${latePercentage}%</span> Com Atraso</p>
                `;

                 const dailyAverages = data.reduce((acc, rec) => {
                    if (!acc[rec.formattedDate]) {
                        acc[rec.formattedDate] = { totalDifference: 0, count: 0 };
                    }
                    acc[rec.formattedDate].totalDifference += rec.arrivalDifference;
                    acc[rec.formattedDate].count++;
                    return acc;
                }, {});

                const sortedDates = Object.keys(dailyAverages).sort((a, b) => {
                    const [dayA, monthA, yearA] = a.split('/');
                    const [dayB, monthB, yearB] = b.split('/');
                    return new Date(`${yearA}-${monthA}-${dayA}`) - new Date(`${yearB}-${monthB}-${dayB}`);
                });

                const barChartLabels = sortedDates;
                const barChartData = sortedDates.map(date => dailyAverages[date].totalDifference / dailyAverages[date].count);

                destroyChart('geral-bar-chart');
                activeCharts['geral-bar-chart'] = new Chart(document.getElementById('geral-bar-chart'), {
                    type: 'bar',
                    data: {
                        labels: barChartLabels,
                        datasets: [{
                            label: 'Média de Minutos',
                            data: barChartData,
                            backgroundColor: barChartData.map(avg => avg > 5 ? '#ef4444' : '#22c55e')
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { title: { display: true, text: 'Minutos de Atraso/Adiantamento' } } } }
                });

                const tableBody = document.getElementById('geral-table-body');
                tableBody.innerHTML = data.sort((a,b) => a.dateObj - b.dateObj).map(rec => `<tr><td>${rec.formattedDate}</td><td>${rec.employeeName}</td><td>${rec.entryTime}</td><td><span class="badge status-${rec.arrivalStatus.replace(' ', '-')}">${rec.arrivalStatus}</span></td><td>${rec.arrivalDifference}</td></tr>`).join('');
            }

            function renderDepartmentView() {
                const data = processData();
                const container = document.getElementById('view-department');
                const departments = [...new Set(data.map(e => e.department || "Sem Departamento"))].filter(d => d && d !== 'GERAL').sort();
                
                container.innerHTML = `
                    <div class="card">
                         <label for="department-selector" class="block text-sm font-medium text-slate-700">Selecionar Departamento:</label>
                        <select id="department-selector" class="mt-1 block w-full md:w-1/2 lg:w-1/3 pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md shadow-sm">
                            ${departments.map(d => `<option value="${d}">${d}</option>`).join('')}
                        </select>
                    </div>
                    <div id="department-content"></div>
                `;

                const selector = container.querySelector('#department-selector');
                selector.addEventListener('change', (e) => displayDepartmentData(e.target.value, data));
                
                if (departments.length > 0) {
                    displayDepartmentData(departments[0], data);
                }
            }

            function displayDepartmentData(departmentName, allData) {
                const contentContainer = document.getElementById('department-content');
                const departmentData = allData.filter(rec => rec.department === departmentName);

                if(departmentData.length === 0) {
                    contentContainer.innerHTML = '<div class="card"><p class="text-center text-slate-500">Nenhum registro encontrado para este departamento.</p></div>';
                    return;
                }
                
                contentContainer.innerHTML = `
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="card">
                            <h2 class="text-xl font-semibold text-slate-700 mb-4 text-center">Resumo de Chegadas</h2>
                            <div class="h-64 sm:h-72"><canvas id="dept-pie-chart"></canvas></div>
                             <div id="dept-percentage-summary" class="text-center mt-4 space-y-1"></div>
                        </div>
                        <div class="card">
                            <h2 class="text-xl font-semibold text-slate-700 mb-4 text-center">Tabela de Registros</h2>
                            <div class="overflow-y-auto h-72">
                                <table class="w-full table-auto">
                                    <thead><tr><th>Data</th><th>Funcionário</th><th>Status</th></tr></thead>
                                    <tbody id="dept-table-body"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>`;

                const statusCounts = departmentData.reduce((acc, rec) => {
                    acc[rec.arrivalStatus] = (acc[rec.arrivalStatus] || 0) + 1;
                    return acc;
                }, {});

                destroyChart('dept-pie-chart');
                
                // Map colors correctly to status
                const deptStatusLabels = Object.keys(statusCounts);
                const deptStatusColors = deptStatusLabels.map(status => {
                    if (status === 'Atrasado') return '#ef4444'; // Red
                    if (status === 'No Horário') return '#22c55e'; // Green
                    if (status === 'Adiantado') return '#eab308'; // Yellow
                    return '#6b7280'; // Gray fallback
                });
                
                activeCharts['dept-pie-chart'] = new Chart(document.getElementById('dept-pie-chart'), { type: 'doughnut', data: { labels: deptStatusLabels, datasets: [{ data: Object.values(statusCounts), backgroundColor: deptStatusColors }] }, options: { responsive: true, maintainAspectRatio: false } });

                const totalRecords = departmentData.length;
                const onTimeCount = (statusCounts['Adiantado'] || 0) + (statusCounts['No Horário'] || 0);
                const lateCount = statusCounts['Atrasado'] || 0;
                const onTimePercentage = totalRecords > 0 ? ((onTimeCount / totalRecords) * 100).toFixed(1) : 0;
                const latePercentage = totalRecords > 0 ? ((lateCount / totalRecords) * 100).toFixed(1) : 0;
                
                document.getElementById('dept-percentage-summary').innerHTML = `
                    <p class="text-sm"><span class="font-bold text-green-600">${onTimePercentage}%</span> Em Conformidade</p>
                    <p class="text-sm"><span class="font-bold text-red-600">${latePercentage}%</span> Com Atraso</p>
                `;

                const tableBody = document.getElementById('dept-table-body');
                tableBody.innerHTML = departmentData.sort((a,b) => a.dateObj - b.dateObj).map(rec => `<tr><td>${rec.formattedDate}</td><td>${rec.employeeName}</td><td><span class="badge status-${rec.arrivalStatus.replace(' ', '-')}">${rec.arrivalStatus}</span></td></tr>`).join('');
            }

            function renderRankingView() {
                const data = processData();
                const container = document.getElementById('view-ranking');
                
                // Inicializar stats para TODOS os funcionários
                const employeeStats = {};
                
                // Primeiro, criar entrada para todos os funcionários do sistema
                Object.keys(currentEmployeesData).forEach(employeeName => {
                    const employeeData = currentEmployeesData[employeeName];
                    employeeStats[employeeName] = {
                        department: employeeData.department || 'N/A',
                        delayCount: 0,
                        delayTotalMinutes: 0,
                        overtimeCount: 0,
                        overtimeTotalMinutes: 0,
                        totalRecords: 0,
                        hasValidRecords: false
                    };
                });
                
                // Processar dados apenas dos funcionários com registros válidos
                data.forEach(rec => {
                    if (employeeStats[rec.employeeName]) {
                        employeeStats[rec.employeeName].totalRecords++;
                        employeeStats[rec.employeeName].hasValidRecords = true;
                        
                        // Contar atrasos
                        if (rec.arrivalStatus === 'Atrasado') {
                            employeeStats[rec.employeeName].delayCount++;
                            employeeStats[rec.employeeName].delayTotalMinutes += Math.abs(rec.arrivalDifference);
                        }
                        
                        // Contar expediente superior (mais que 5 minutos)
                        if (rec.leaveDifference > 5) {
                            employeeStats[rec.employeeName].overtimeCount++;
                            employeeStats[rec.employeeName].overtimeTotalMinutes += rec.leaveDifference;
                        }
                    }
                });
                
                // Calcular médias e criar ranking
                const ranking = Object.entries(employeeStats)
                    .map(([name, stats]) => ({
                        name,
                        department: stats.department,
                        delayCount: stats.delayCount,
                        delayAverage: stats.delayCount > 0 ? (stats.delayTotalMinutes / stats.delayCount).toFixed(1) : 0,
                        delayTotalMinutes: stats.delayTotalMinutes,
                        overtimeTotalMinutes: stats.overtimeTotalMinutes,
                        hasValidRecords: stats.hasValidRecords
                    }))
                    .sort((a, b) => {
                        // Ordenar por quantidade de atrasos (crescente - pontuais primeiro), depois por total de minutos atrasados
                        if (a.delayCount !== b.delayCount) {
                            return a.delayCount - b.delayCount;
                        }
                        return a.delayTotalMinutes - b.delayTotalMinutes;
                    });
                
                container.innerHTML = `
                    <div class="card">
                        <h2 class="text-2xl font-semibold text-slate-700 mb-6">
                            Ranking de Atrasos e Expediente Superior
                            <span class="text-base font-normal text-slate-500 block mt-2">
                                Total: ${ranking.length} funcionários | 
                                Com registros válidos: ${ranking.filter(emp => emp.hasValidRecords).length} | 
                                Sem registros: ${ranking.filter(emp => !emp.hasValidRecords).length}
                            </span>
                        </h2>
                        
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Posição</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Funcionário</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Departamento</th>
                                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Qtd Atrasos</th>
                                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Atraso Médio</th>
                                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Total Min. Atrasados</th>
                                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Total Min. Extras</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    ${ranking.map((employee, index) => `
                                        <tr class="${index % 2 === 0 ? 'bg-white' : 'bg-gray-50'} hover:bg-gray-100">
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">
                                                ${index + 1}°
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                                ${employee.name}
                                                ${!employee.hasValidRecords ? '<span class="text-xs text-gray-400 block">(sem registros válidos)</span>' : ''}
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                ${employee.department || 'N/A'}
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                                                    employee.delayCount === 0 ? 'bg-green-100 text-green-800' :
                                                    employee.delayCount <= 5 ? 'bg-yellow-100 text-yellow-800' :
                                                    employee.delayCount <= 10 ? 'bg-orange-100 text-orange-800' :
                                                    'bg-red-100 text-red-800'
                                                }">
                                                    ${employee.delayCount}
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-900">
                                                ${employee.delayAverage > 0 ? `${employee.delayAverage} min` : '-'}
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-900">
                                                ${employee.delayTotalMinutes > 0 ? `${employee.delayTotalMinutes} min` : '-'}
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-900">
                                                ${employee.overtimeTotalMinutes > 0 ? `${employee.overtimeTotalMinutes} min` : '-'}
                                            </td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="bg-green-50 p-4 rounded-lg">
                                <h3 class="text-lg font-semibold text-green-800 mb-2">Top 3 Mais Pontuais</h3>
                                <ul class="space-y-1">
                                    ${ranking
                                        .filter(emp => emp.delayCount === 0)
                                        .slice(0, 3)
                                        .map((emp, idx) => `
                                            <li class="text-sm text-green-700">
                                                ${idx + 1}° ${emp.name} - 0 atrasos
                                            </li>
                                        `).join('')}
                                </ul>
                            </div>
                            
                            <div class="bg-red-50 p-4 rounded-lg">
                                <h3 class="text-lg font-semibold text-red-800 mb-2">Top 3 Maiores Atrasados</h3>
                                <ul class="space-y-1">
                                    ${ranking
                                        .filter(emp => emp.delayCount > 0)
                                        .sort((a, b) => b.delayCount - a.delayCount || b.delayTotalMinutes - a.delayTotalMinutes)
                                        .slice(0, 3)
                                        .map((emp, idx) => `
                                            <li class="text-sm text-red-700">
                                                ${idx + 1}° ${emp.name} - ${emp.delayCount} atrasos
                                            </li>
                                        `).join('')}
                                </ul>
                            </div>
                            
                            <div class="bg-blue-50 p-4 rounded-lg">
                                <h3 class="text-lg font-semibold text-blue-800 mb-2">Maiores Expedientes Extras</h3>
                                <ul class="space-y-1">
                                    ${ranking
                                        .filter(emp => emp.overtimeTotalMinutes > 0)
                                        .sort((a, b) => b.overtimeTotalMinutes - a.overtimeTotalMinutes)
                                        .slice(0, 3)
                                        .map((emp, idx) => `
                                            <li class="text-sm text-blue-700">
                                                ${idx + 1}° ${emp.name} - ${emp.overtimeTotalMinutes} min extras
                                            </li>
                                        `).join('')}
                                </ul>
                            </div>
                        </div>
                    </div>
                `;
            }

            function renderIndividualView() {
                const data = processData();
                const container = document.getElementById('view-individual');
                container.innerHTML = `
                    <header class="card">
                        <div class="mt-4">
                            <label for="employee-selector" class="block text-sm font-medium text-slate-700">Selecionar Funcionário(a):</label>
                            <select id="employee-selector" class="mt-1 block w-full md:w-1/2 lg:w-1/3 pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md shadow-sm"></select>
                        </div>
                        <div id="employee-info" class="mt-4 text-slate-600 border-t pt-4"></div>
                    </header>
                    <div id="individual-charts-container" class="hidden">
                        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
                            <div class="lg:col-span-2 card">
                                <h2 class="text-xl font-semibold text-slate-700 mb-4 text-center">Resumo de Chegadas</h2>
                                <div class="h-64 sm:h-72"><canvas id="individual-pie-chart"></canvas></div>
                                 <div id="individual-percentage-summary" class="text-center mt-4 space-y-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <h2 class="text-xl font-semibold text-slate-700 mb-4">Registros Detalhados</h2>
                        <div class="overflow-x-auto">
                            <table class="w-full table-auto border-collapse">
                                <thead><tr><th>Data</th><th>Entrada</th><th>Status</th><th>Diferença</th></tr></thead>
                                <tbody id="individual-table-body"></tbody>
                            </table>
                        </div>
                    </div>`;

                const employeeSelector = container.querySelector('#employee-selector');
                const employeeNames = Object.keys(currentEmployeesData).sort();
                employeeSelector.innerHTML = employeeNames.map(name => `<option value="${name}">${name}</option>`).join('');
                
                const displayIndividualData = (employeeName) => {
                    const employeeData = currentEmployeesData[employeeName];
                    const records = data.filter(rec => rec.employeeName === employeeName);
                    const infoContainer = document.getElementById('employee-info');
                    const tableBody = document.getElementById('individual-table-body');
                    const chartsContainer = document.getElementById('individual-charts-container');
                    
                    infoContainer.innerHTML = `
                        <p><span class="font-semibold">Funcionário(a):</span> <span>${employeeName}</span></p>
                        <p><span class="font-semibold">Nº Folha:</span> <span>${employeeData.sheetNumber || 'N/A'}</span></p>
                        <p><span class="font-semibold">Horário Previsto:</span> <span class="font-bold text-slate-700">${employeeData.scheduledEntryTime || 'N/A'}</span></p>`;

                    destroyChart('individual-pie-chart');
                    if (records.length === 0) {
                        chartsContainer.classList.add('hidden');
                        tableBody.innerHTML = `<tr><td colspan="4" class="text-center py-4">Nenhum registro válido.</td></tr>`;
                    } else {
                        chartsContainer.classList.remove('hidden');
                        tableBody.innerHTML = records.map(rec => `<tr><td>${rec.formattedDate}</td><td>${rec.entryTime}</td><td><span class="badge status-${rec.arrivalStatus.replace(' ', '-')}">${rec.arrivalStatus}</span></td><td>${rec.arrivalDifference} min</td></tr>`).join('');
                        const statusCounts = records.reduce((acc, rec) => { acc[rec.arrivalStatus] = (acc[rec.arrivalStatus] || 0) + 1; return acc; }, {});
                        
                        // Map colors correctly to status
                        const statusLabels = Object.keys(statusCounts);
                        const statusColors = statusLabels.map(status => {
                            if (status === 'Atrasado') return '#ef4444'; // Red
                            if (status === 'No Horário') return '#22c55e'; // Green
                            if (status === 'Adiantado') return '#eab308'; // Yellow
                            return '#6b7280'; // Gray fallback
                        });
                        
                        activeCharts['individual-pie-chart'] = new Chart(document.getElementById('individual-pie-chart'), { type: 'doughnut', data: { labels: statusLabels, datasets: [{ data: Object.values(statusCounts), backgroundColor: statusColors }] }, options: { responsive: true, maintainAspectRatio: false } });

                        const totalRecords = records.length;
                        const onTimeCount = (statusCounts['Adiantado'] || 0) + (statusCounts['No Horário'] || 0);
                        const lateCount = statusCounts['Atrasado'] || 0;
                        const onTimePercentage = totalRecords > 0 ? ((onTimeCount / totalRecords) * 100).toFixed(1) : 0;
                        const latePercentage = totalRecords > 0 ? ((lateCount / totalRecords) * 100).toFixed(1) : 0;
                        
                        document.getElementById('individual-percentage-summary').innerHTML = `
                            <p class="text-sm"><span class="font-bold text-green-600">${onTimePercentage}%</span> Em Conformidade</p>
                            <p class="text-sm"><span class="font-bold text-red-600">${latePercentage}%</span> Com Atraso</p>
                        `;
                    }
                };

                employeeSelector.addEventListener('change', (e) => displayIndividualData(e.target.value));
                if (employeeNames.length > 0) {
                    displayIndividualData(employeeNames[0]);
                }
            }

            function renderValidationView() {
                const data = processData();
                const container = document.getElementById('view-validation');
                container.innerHTML = `
                    <div class="card">
                        <h2 class="text-xl font-semibold text-slate-700 mb-4">Funcionários Processados</h2>
                        <ul id="employee-validation-list" class="list-disc list-inside space-y-1 text-slate-600"></ul>
                    </div>
                    <div class="card lg:col-span-2">
                         <h2 class="text-xl font-semibold text-slate-700 mb-4">Contagem de Registros Válidos</h2>
                         <div class="overflow-x-auto">
                            <table class="w-full table-auto">
                               <thead><tr><th>Funcionário(a)</th><th>Dias Válidos</th></tr></thead>
                               <tbody id="record-count-body"></tbody>
                            </table>
                        </div>
                    </div>`;

                const employeeNames = Object.keys(currentEmployeesData).sort();
                const employeeList = document.getElementById('employee-validation-list');
                employeeList.innerHTML = employeeNames.map(name => `<li>${name}</li>`).join('');

                const recordCountBody = document.getElementById('record-count-body');
                recordCountBody.innerHTML = employeeNames.map(name => {
                    const validRecords = data.filter(rec => rec.employeeName === name).length;
                    return `<tr><td>${name}</td><td>${validRecords}</td></tr>`;
                }).join('');
            }
            
            // --- Main Execution ---
            const tabs = document.querySelectorAll('.tab-button');
            const views = document.querySelectorAll('.view-content');

            function switchTab(tabId) {
                views.forEach(view => view.classList.toggle('active', view.id === tabId));
                tabs.forEach(tab => tab.classList.toggle('active', tab.dataset.tab === tabId));
            }

            function refreshAllViews() {
                renderGeneralView();
                renderDepartmentView();
                renderRankingView();
                renderIndividualView();
                renderValidationView();
            }

            // Month selector functionality
            const monthSelector = document.getElementById('month-selector');
            monthSelector.addEventListener('change', (e) => {
                currentMonth = e.target.value;
                currentEmployeesData = availableMonths[currentMonth].data;
                refreshAllViews();
            });

            tabs.forEach(tab => {
                tab.addEventListener('click', (e) => switchTab(e.target.dataset.tab));
            });

            // Initial render of all tabs
            refreshAllViews();
        });
    </script>
</body>
</html>
